# Copy to server/.env and fill in. Never commit .env.

PORT=5173

# Plaid (https://dashboard.plaid.com/developers/keys). Sandbox keys are free.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Optional: without it,
# gifts are recorded locally and not invoiced through Stripe.
STRIPE_SECRET_KEY=

# Charity that receives gifts.
CHARITY_NAME=VGH & UBC Hospital Foundation
CHARITY_SHORT_NAME=VGH Foundation
CHARITY_URL=https://vghfoundation.ca
CHARITY_REGISTRATION=132173063RR0001

# Sample giving from other companies, shown alongside real gifts. Set to off for real data only.
COMMUNITY_SAMPLE=on
