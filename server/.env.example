# Copy to server/.env and fill in. Never commit .env.

PORT=5173

# Plaid (https://dashboard.plaid.com/developers/keys). Sandbox keys are free.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Optional: without it,
# invoices are generated locally and not sent through Stripe.
STRIPE_SECRET_KEY=

# Charity that receives pledges. Confirm the exact registered name before the demo.
CHARITY_NAME=VGH & UBC Hospital Foundation
CHARITY_DESCRIPTION=Supports Vancouver General Hospital and UBC Hospital.
