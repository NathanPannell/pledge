{
  "manifest_version": 3,
  "name": "Pledge · Round-ups for charity",
  "version": "0.2.0",
  "description": "Round up OpenRouter credit top-ups for charity. Sandbox prototype; no automatic charges.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pledge.pauravhp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.woff2"
      ],
      "matches": [
        "https://openrouter.ai/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pledge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://openrouter.ai/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
