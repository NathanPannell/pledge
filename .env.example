# Copy to .env in the repository root. Never commit .env or share live keys.
PORT=5173
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Leave EXTENSION_ORIGIN empty to package the extension for APP_ORIGIN.
EXTENSION_ORIGIN=

# Both flows can use the same sandbox key; aliases also work independently.
# Invoice flow needs Customers, Invoices, and Invoice Items permissions;
# roundups need Customers, Checkout Sessions, and Payment Intents permissions.
STRIPE_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional, for a separately registered sandbox webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Nathan's monthly invoices stay local; Stripe is used only by the extension.
# Set to stripe only when intentionally enabling his optional Stripe integration.
COMPANY_STRIPE_MODE=local

# Local defaults are server/data/pledge.db (+ secret.key) and .local/roundups.sqlite.
# Hosting must use absolute paths outside the repository/release directories.
DATA_DIR=
ROUNDUPS_DB=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
COMMUNITY_SAMPLE=on
