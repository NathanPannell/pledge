[Unit]
Description=Pledge frontend and combined company/OpenRouter sandbox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pledge/current
EnvironmentFile=%h/.config/pledge/demo.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node --disable-warning=ExperimentalWarning server/src/main.js
Restart=always
RestartSec=2
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
